#!/usr/bin/env bash
# aether-switch-desktop - Hot-swaps between KDE Plasma 6 and GNOME Shell in live preview

set -e

SDDM_CONF="/etc/sddm.conf.d/autologin.conf"
[ -f "$SDDM_CONF" ] || SDDM_CONF="/etc/sddm.conf"

CURRENT_SESSION="plasma"
if [ -f "$SDDM_CONF" ]; then
    CURRENT_SESSION=$(grep -E "^Session=" "$SDDM_CONF" | cut -d'=' -f2 | tr -d ' ' || echo "plasma")
fi

if [ "$CURRENT_SESSION" = "plasma" ]; then
    TARGET_SESSION="gnome"
    TARGET_NAME="GNOME Desktop"
else
    TARGET_SESSION="plasma"
    TARGET_NAME="KDE Plasma 6"
fi

if command -v notify-send &>/dev/null; then
    notify-send -u normal -i preferences-desktop-theme "AetherOS Desktop Switcher" "Switching desktop to ${TARGET_NAME}..." || true
fi

sudo sed -i "s|^Session=.*|Session=${TARGET_SESSION}|" "$SDDM_CONF" 2>/dev/null || true

sleep 1
sudo systemctl restart sddm.service
